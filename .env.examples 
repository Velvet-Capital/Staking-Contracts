# Velvet Staking Contracts Environment Variables

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Deployer wallet address (used for named accounts)
DEPLOYER=0x1234567890123456789012345678901234567890

# Mnemonic phrase for wallet accounts (12 or 24 words)
# IMPORTANT: Never commit your real mnemonic to version control
MEMONIC="your twelve word mnemonic phrase goes here for wallet derivation purposes only"

# =============================================================================
# NETWORK RPC ENDPOINTS
# =============================================================================

# Base Network RPC URL (optional - defaults to public RPC)
BASE_RPC=https://mainnet.base.org

# BSC Network RPC URL (optional - uses public RPC by default)
BSC_RPC=https://bsc-dataseed1.binance.org

# =============================================================================
# BLOCKCHAIN EXPLORER API KEYS
# =============================================================================

# Etherscan API Key (for Base network contract verification)
ETHERSCAN_KEY=your_etherscan_api_key_here

# BSCScan API Key (for BSC network contract verification)
BSCSCAN_KEY=your_bscscan_api_key_here

# =============================================================================
# CONTRACT DEPLOYMENT SETTINGS
# =============================================================================



# veVelvet max weeks for staking
# Default: 200 weeks
MAX_STAKING_WEEKS=200


# velvet token address 
VELVET_TOKEN_ADDRESS=
